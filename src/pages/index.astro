---
import '../styles/site.css';

const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`;
const image = (name: string) => `${base}images/${name}.webp`;

const breads = [
  { id: 'country', name: 'Country Sourdough', category: 'sourdough', label: 'Sourdough', description: 'Klasik berkulit renyah dengan rasa asam yang seimbang.', price: 65000, image: 'country', alt: 'Roti sourdough bulat dengan kulit berbalut tepung' },
  { id: 'whole-wheat', name: 'Whole Wheat Sourdough', category: 'sourdough', label: 'Sourdough', description: 'Gandum utuh dengan rasa lebih dalam dan tekstur padat.', price: 70000, image: 'whole-wheat', alt: 'Roti gandum rustic dengan taburan biji-bijian' },
  { id: 'olive', name: 'Olive Sourdough', category: 'sourdough', label: 'Sourdough', description: 'Irisan zaitun memberi rasa gurih di setiap potong.', price: 75000, image: 'olive', alt: 'Potongan roti artisan dengan buah zaitun di dalamnya' },
  { id: 'milk', name: 'Japanese Milk Bread', category: 'soft', label: 'Roti lembut', description: 'Lembut seperti kapas, cocok untuk roti panggang pagi.', price: 55000, image: 'milk', alt: 'Roti susu putih yang sudah diiris' },
  { id: 'brioche', name: 'Brioche Loaf', category: 'soft', label: 'Roti lembut', description: 'Kaya mentega dan telur, pas untuk French toast.', price: 60000, image: 'brioche', alt: 'Brioche loaf keemasan yang telah dipotong' },
  { id: 'rye', name: 'Rye Bread', category: 'specialty', label: 'Pilihan khusus', description: 'Karakter rye yang pekat untuk sandwich yang lebih mantap.', price: 75000, image: 'rye', alt: 'Roti rye gelap di atas meja dengan tepung' },
  { id: 'focaccia', name: 'Focaccia Rosemary', category: 'specialty', label: 'Pilihan khusus', description: 'Empuk, gurih, dengan aroma rosemary dan minyak zaitun.', price: 50000, image: 'focaccia', alt: 'Potongan focaccia dengan daun rosemary' },
  { id: 'ciabatta', name: 'Ciabatta', category: 'specialty', label: 'Pilihan khusus', description: 'Bagian dalam berongga, siap diisi apa saja.', price: 45000, image: 'ciabatta', alt: 'Beberapa roti ciabatta bertabur tepung' },
];

const pastries = [
  { id: 'croissant', name: 'Plain Croissant', description: 'Renyah di luar, ringan di dalam.', price: 25000, image: 'croissant', alt: 'Croissant keemasan di atas alas terang' },
  { id: 'chocolat', name: 'Pain au Chocolat', description: 'Lapisan pastry dengan isi cokelat.', price: 30000, image: 'chocolat', alt: 'Pain au chocolat dengan lapisan pastry keemasan' },
  { id: 'almond', name: 'Almond Croissant', description: 'Bertabur almond, manis secukupnya.', price: 35000, image: 'almond', alt: 'Croissant bertabur irisan almond' },
  { id: 'cinnamon', name: 'Cinnamon Roll', description: 'Gulungan kayu manis dengan glasir.', price: 28000, image: 'cinnamon', alt: 'Cinnamon roll berlapis glasir' },
  { id: 'kouign', name: 'Kouign-Amann', description: 'Pastry karamel dengan lapisan renyah.', price: 32000, image: 'kouign', alt: 'Kouign-Amann bundar berwarna keemasan' },
];

const schedule = [
  { time: '06.00', label: 'Sourdough pertama', detail: 'Country, whole wheat, dan olive.' },
  { time: '07.30', label: 'Pastry pagi', detail: 'Croissant dan pilihan pastry.' },
  { time: '10.00', label: 'Roti lembut', detail: 'Milk bread dan brioche.' },
  { time: '14.00', label: 'Sourdough kedua', detail: 'Pilihan sourdough berikutnya.' },
  { time: '16.00', label: 'Pastry sore', detail: 'Pilihan pastry berikutnya.' },
];

const rupiah = (value: number) => `Rp ${new Intl.NumberFormat('id-ID').format(value)}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffdf8" />
    <title>Loaf & Co. Bakery | Pilihan Roti & Pastry</title>
    <meta name="description" content="Kenali delapan roti artisan dan lima pastry dalam konsep menu Loaf & Co. Bakery. Lihat harga ilustratif dan simpan daftar pilihan di perangkatmu." />
    <link rel="canonical" href={new URL(base, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Loaf & Co. Bakery | Pilihan Roti & Pastry" />
    <meta property="og:description" content="Jelajahi konsep menu roti dan pastry, lalu simpan pilihanmu secara lokal." />
    <meta property="og:image" content={new URL(`${base}images/hero-country.webp`, Astro.site).href} />
    <link rel="preload" as="image" href={image('hero-country')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <header class="site-header" id="top">
      <div class="shell header-inner">
        <a class="brand" href={base} aria-label="Loaf & Co. Beranda">Loaf <span>&</span> Co<span class="brand-period">.</span></a>
        <nav class="desktop-nav" aria-label="Navigasi utama">
          <a href="#menu">Roti</a><a href="#pastry">Pastry</a><a href="#story">Cerita Kami</a><a href="#wholesale">Wholesale</a><a href="#visit">Lokasi</a>
        </nav>
        <div class="header-actions">
          <button class="bag-button" type="button" data-open-bag aria-label="Buka daftar pilihan, 0 produk"><span class="bag-icon" aria-hidden="true"></span><span class="bag-count" data-bag-count>0</span></button>
          <a class="button button-accent header-order" href="#menu">Pilih Roti <span aria-hidden="true">↗</span></a>
          <button class="menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="Buka menu"><span></span><span></span><span></span></button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Navigasi seluler" hidden>
        <a href="#menu">Roti</a><a href="#pastry">Pastry</a><a href="#story">Cerita Kami</a><a href="#wholesale">Wholesale</a><a href="#visit">Lokasi</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="hero-copy-inner">
            <h1 id="hero-title">Roti enak bikin hari <em>lebih hangat.</em></h1>
            <p>Kenali sourdough, roti lembut, dan pastry yang ingin kamu taruh di meja makan.</p>
            <a class="button button-accent" href="#menu">Jelajahi menu <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-photo-wrap">
          <img class="hero-photo" src={image('hero-country')} alt="Roti sourdough artisan dengan kulit kecokelatan" width="1600" height="1068" loading="eager" fetchpriority="high" />
          <div class="hero-caption"><span>Country Sourdough</span><span>Mulai {rupiah(65000)} <small>· harga konsep</small></span></div>
        </div>
      </section>

      <section class="menu-section section-space" id="menu" aria-labelledby="menu-title">
        <div class="shell">
          <div class="section-heading"><h2 id="menu-title">Pilih rotimu.</h2><p>Dari kerak yang renyah sampai irisan selembut awan. Pilih berdasarkan yang kamu suka.</p></div>
          <div class="filters" role="group" aria-label="Saring jenis roti">
            <button type="button" class="filter active" data-filter="all" aria-pressed="true">Semua roti</button>
            <button type="button" class="filter" data-filter="sourdough" aria-pressed="false">Sourdough</button>
            <button type="button" class="filter" data-filter="soft" aria-pressed="false">Roti lembut</button>
            <button type="button" class="filter" data-filter="specialty" aria-pressed="false">Pilihan khusus</button>
          </div>
          <div class="product-grid" id="product-grid">
            {breads.map((item) => (
              <article class="product" id={`product-${item.id}`} data-category={item.category} data-product-id={item.id} data-product-name={item.name} data-product-price={item.price}>
                <div class="product-image"><img src={image(item.image)} alt={item.alt} width="650" height="650" loading="lazy" /></div>
                <div class="product-body"><span class="product-category">{item.label}</span><h3>{item.name}</h3><p>{item.description}</p><div class="product-bottom"><strong>{rupiah(item.price)}</strong><button class="add-button" type="button" data-add={item.id} aria-label={`Tambahkan ${item.name} ke daftar pilihan`}>Tambah <span aria-hidden="true">+</span></button></div></div>
              </article>
            ))}
          </div>
          <p class="image-disclaimer">Foto stok adalah ilustrasi jenis produk, bukan foto produk toko. Harga konsep dan ketersediaan belum dikonfirmasi.</p>
        </div>
      </section>

      <section class="story-section section-space" id="story" aria-labelledby="story-title">
        <div class="shell story-layout">
          <div class="story-photos">
            <img class="story-photo-main" src={image('gallery-dough')} alt="Adonan roti sedang dikerjakan di atas meja" width="1000" height="667" loading="lazy" />
            <img class="story-photo-detail" src={image('story')} alt="Proses menyiapkan adonan roti sebagai ilustrasi" width="1100" height="1650" loading="lazy" />
          </div>
          <div class="story-copy"><h2 id="story-title">Ada cerita di setiap adonan.</h2><p>Mulai dari tepung dan air, lalu dibentuk, dibiarkan berkembang, dan dipanggang. Proses yang pelan memberi kita waktu untuk memperhatikan roti dari dekat.</p><p>Di sini, kamu bisa mengenal pilihan roti dan pastry satu per satu sebelum menentukan favoritmu.</p><a class="text-link" href="#jadwal">Lihat rencana waktu panggang <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section class="pastry-section section-space" id="pastry" aria-labelledby="pastry-title">
        <div class="shell pastry-lead">
          <div class="pastry-heading"><h2 id="pastry-title">Yang berlapis, yang manis.</h2><p>Lima pilihan pastry untuk menemani pagi atau jeda soremu.</p></div>
          <div class="pastry-feature"><img src={image('gallery-croissants')} alt="Sekumpulan croissant berlapis yang baru dipanggang" width="1000" height="1500" loading="lazy" /></div>
        </div>
        <div class="shell">
          <div class="pastry-scroller" aria-label="Pilihan pastry">
            {pastries.map((item) => <article class="pastry-item" id={`product-${item.id}`} data-product-id={item.id} data-product-name={item.name} data-product-price={item.price}><div class="pastry-image"><img src={image(item.image)} alt={item.alt} width="650" height="650" loading="lazy" /></div><div class="pastry-info"><div><h3>{item.name}</h3><p>{item.description}</p><strong>{rupiah(item.price)}</strong></div><button type="button" class="add-button" data-add={item.id} aria-label={`Tambahkan ${item.name} ke daftar pilihan`}>Tambah <span aria-hidden="true">+</span></button></div></article>)}
          </div>
          <p class="swipe-hint">Geser ke samping untuk melihat semua pastry.</p>
          <p class="image-disclaimer">Foto stok adalah ilustrasi jenis produk. Harga konsep dan ketersediaan belum dikonfirmasi.</p>
        </div>
      </section>

      <section class="schedule-section section-space" id="jadwal" aria-labelledby="schedule-title"><div class="shell schedule-layout"><div class="schedule-copy"><h2 id="schedule-title">Satu hari, banyak alasan untuk roti.</h2><p>Ini rencana sesi panggang dari brief, bukan jadwal operasional atau ketersediaan langsung. Waktu perlu dikonfirmasi sebelum berkunjung.</p><img src={image('gallery-oven')} alt="Proses memanggang roti dalam oven sebagai ilustrasi" width="1100" height="733" loading="lazy" /></div><ol class="schedule-list">{schedule.map((item) => <li><time>{item.time}</time><div><h3>{item.label}</h3><p>{item.detail}</p></div></li>)}</ol></div></section>

      <section class="preorder-section section-space" id="preorder" aria-labelledby="preorder-title"><div class="shell preorder-layout"><div><h2 id="preorder-title">Sudah ketemu favoritmu?</h2><p>Tambahkan roti dan pastry ke daftar pilihan di perangkatmu. Kamu bisa menyalinnya untuk disimpan; daftar ini tidak mengirim pesanan.</p><button type="button" class="button button-light" data-open-bag>Lihat daftar pilihan <span aria-hidden="true">↗</span></button></div><div class="preorder-note"><strong>Daftar kecil untuk rencana besarmu.</strong><p>Jumlah dan perkiraan total tersimpan di perangkat ini. Harga, stok, kontak, dan layanan pre-order belum dikonfirmasi.</p><a href="#menu" class="text-link">Kembali pilih roti <span aria-hidden="true">↗</span></a></div></div></section>

      <section class="wholesale-section section-space" id="wholesale" aria-labelledby="wholesale-title"><div class="shell wholesale-layout"><div class="wholesale-photo"><img src={image('gallery-shelves')} alt="Rak berisi pilihan roti sebagai ilustrasi, bukan lokasi Loaf & Co." width="1100" height="734" loading="lazy" /></div><div class="wholesale-copy"><h2 id="wholesale-title">Untuk meja yang lebih ramai.</h2><p>Mengelola kafe atau restoran? Jelajahi jenis roti dan pastry yang mungkin cocok untuk menumu.</p><p>Informasi suplai, jumlah minimum, jadwal, serta kanal kerja sama belum tersedia. Halaman ini belum menerima permintaan wholesale.</p><a class="text-link" href="#menu">Lihat pilihan roti <span aria-hidden="true">↗</span></a></div></div></section>

      <section class="visit-section section-space" id="visit" aria-labelledby="visit-title"><div class="shell visit-layout"><div><h2 id="visit-title">Sampai bertemu di lain waktu.</h2><p>Konsep ini ditujukan untuk area Jakarta Selatan, tetapi alamat toko dan kontak resmi belum tersedia. Jangan gunakan rencana jam buka ini sebagai panduan berkunjung sebelum dikonfirmasi.</p><a class="text-link" href="#menu">Lihat menu lagi <span aria-hidden="true">↗</span></a></div><div class="visit-board"><h3>Rencana jam buka <span>(belum dikonfirmasi)</span></h3><div><strong>Selasa – Jumat</strong><span>07.00 – 19.00</span></div><div><strong>Sabtu</strong><span>07.00 – 20.00</span></div><div><strong>Minggu</strong><span>07.00 – 17.00</span></div><div><strong>Senin</strong><span>Tutup</span></div></div></div></section>
    </main>

    <footer class="site-footer"><div class="shell"><div class="footer-main"><div><a class="brand footer-brand" href={base}>Loaf <span>&</span> Co<span class="brand-period">.</span></a><p>Roti Asli, Dipanggang Hari Ini.</p></div><div class="footer-nav"><div><span>Jelajahi</span><a href="#menu">Menu roti</a><a href="#pastry">Pastry</a><a href="#story">Cerita kami</a></div><div><span>Informasi</span><a href="#jadwal">Jadwal panggang</a><a href="#preorder">Daftar pilihan</a><a href="#wholesale">Wholesale</a><a href="#visit">Lokasi & jam</a></div></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Loaf & Co. Bakery</span><span>Konsep menu dan foto ilustratif. Kontak resmi belum tersedia.</span><a href="#top">Kembali ke atas ↑</a></div></div></footer>

    <dialog class="bag-dialog" id="bag-dialog" aria-labelledby="bag-title"><div class="bag-panel"><div class="bag-head"><div><h2 id="bag-title">Daftar pilihanmu.</h2><p>Disimpan di perangkat ini, belum menjadi pesanan.</p></div><button type="button" class="bag-close" data-close-bag aria-label="Tutup daftar pilihan">×</button></div><div class="bag-items" id="bag-items"></div><div class="bag-footer"><div class="bag-total"><span>Perkiraan total</span><strong id="bag-total">Rp 0</strong></div><p>Ini bukan transaksi. Harga dan ketersediaan belum dikonfirmasi kepada toko.</p><button type="button" class="button button-accent bag-copy" id="copy-bag">Salin daftar pilihan <span aria-hidden="true">↗</span></button><p class="copy-feedback" id="copy-feedback" role="status"></p></div></div></dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      const money = (value: number) => `Rp ${new Intl.NumberFormat('id-ID').format(value)}`;
      const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const mobileNav = document.querySelector<HTMLElement>('.mobile-nav')!;
      const closeMenu = () => { mobileNav.hidden = true; menuToggle.setAttribute('aria-expanded', 'false'); menuToggle.setAttribute('aria-label', 'Buka menu'); };
      menuToggle.addEventListener('click', () => { const open = mobileNav.hidden; mobileNav.hidden = !open; menuToggle.setAttribute('aria-expanded', String(open)); menuToggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu'); });
      mobileNav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });

      const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const products = [...document.querySelectorAll<HTMLElement>('.product')];
      filters.forEach(filter => filter.addEventListener('click', () => {
        filters.forEach(button => { const selected = button === filter; button.classList.toggle('active', selected); button.setAttribute('aria-pressed', String(selected)); });
        products.forEach(product => { product.hidden = filter.dataset.filter !== 'all' && product.dataset.category !== filter.dataset.filter; });
      }));

      const bag = new Map<string, number>();
      const storageKey = 'loaf-co-selection';
      try { const saved = JSON.parse(localStorage.getItem(storageKey) || '{}'); if (saved && typeof saved === 'object') Object.entries(saved).forEach(([id, qty]) => { if (document.querySelector(`[data-product-id="${CSS.escape(id)}"]`) && Number.isInteger(qty) && (qty as number) > 0 && (qty as number) <= 99) bag.set(id, qty as number); }); } catch { /* Private browsing may disallow storage. */ }
      const catalog = new Map([...document.querySelectorAll<HTMLElement>('[data-product-id]')].map(el => [el.dataset.productId!, { name: el.dataset.productName!, price: Number(el.dataset.productPrice) }]));
      const dialog = document.querySelector<HTMLDialogElement>('#bag-dialog')!;
      const bagItems = $('#bag-items');
      const copyButton = document.querySelector<HTMLButtonElement>('#copy-bag')!;
      const saveBag = () => { try { localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(bag))); } catch { /* The current visit still works. */ } };
      let toastTimeout: ReturnType<typeof setTimeout>;
      const notify = (message: string) => { const toast = $('#toast'); toast.textContent = message; toast.classList.add('show'); clearTimeout(toastTimeout); toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000); };
      const renderBag = () => {
        const count = [...bag.values()].reduce((sum, qty) => sum + qty, 0);
        document.querySelectorAll<HTMLElement>('[data-bag-count]').forEach(el => { el.textContent = String(count); });
        document.querySelector<HTMLButtonElement>('.bag-button')!.setAttribute('aria-label', `Buka daftar pilihan, ${count} produk`);
        bagItems.replaceChildren();
        if (!count) { const empty = document.createElement('div'); empty.className = 'bag-empty'; empty.innerHTML = '<strong>Belum ada roti di sini.</strong><p>Pilih roti atau pastry dari menu, lalu lihat daftarmu di sini.</p>'; bagItems.append(empty); }
        let total = 0;
        bag.forEach((qty, id) => {
          const product = catalog.get(id); if (!product) return;
          total += product.price * qty;
          const row = document.createElement('div'); row.className = 'bag-row';
          const info = document.createElement('div'); const title = document.createElement('strong'); title.textContent = product.name; const price = document.createElement('span'); price.textContent = money(product.price); info.append(title, price);
          const controls = document.createElement('div'); controls.className = 'quantity';
          const minus = document.createElement('button'); minus.type = 'button'; minus.textContent = '−'; minus.setAttribute('aria-label', `Kurangi ${product.name}`); minus.addEventListener('click', () => changeQuantity(id, -1));
          const amount = document.createElement('span'); amount.textContent = String(qty);
          const plus = document.createElement('button'); plus.type = 'button'; plus.textContent = '+'; plus.setAttribute('aria-label', `Tambah ${product.name}`); plus.addEventListener('click', () => changeQuantity(id, 1));
          controls.append(minus, amount, plus); row.append(info, controls); bagItems.append(row);
        });
        $('#bag-total').textContent = money(total);
        copyButton.disabled = count === 0;
        saveBag();
      };
      const changeQuantity = (id: string, delta: number) => { const next = Math.min(99, (bag.get(id) || 0) + delta); if (next > 0) bag.set(id, next); else bag.delete(id); renderBag(); };
      document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach(button => button.addEventListener('click', () => { const id = button.dataset.add!; changeQuantity(id, 1); notify(`${catalog.get(id)?.name} ditambahkan ke daftar.`); }));
      document.querySelectorAll('[data-open-bag]').forEach(button => button.addEventListener('click', () => { renderBag(); dialog.showModal(); }));
      $('[data-close-bag]').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
      copyButton.addEventListener('click', async () => {
        const lines = [...bag].map(([id, qty]) => `${qty} × ${catalog.get(id)!.name} (${money(catalog.get(id)!.price * qty)})`);
        const text = `Daftar pilihan Loaf & Co.\n${lines.join('\n')}\nPerkiraan total: ${$('#bag-total').textContent}\nHarga dan ketersediaan belum dikonfirmasi. Ini bukan pesanan.`;
        try { await navigator.clipboard.writeText(text); $('#copy-feedback').textContent = 'Daftar tersalin. Ini belum mengirim pesanan.'; }
        catch { $('#copy-feedback').textContent = 'Gagal menyalin. Izinkan akses clipboard lalu coba lagi.'; }
      });
      renderBag();
    </script>
  </body>
</html>

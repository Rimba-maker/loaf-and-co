---
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Loaf & Co. Bakery — Sourdough & Artisan Bread Jakarta</title>
  <meta name="description" content="Roti sourdough, croissant, dan artisan bread fresh dipanggang setiap hari di Jakarta. Tanpa pengawet, fermentasi 24 jam. Pre-order via WhatsApp." />
  <meta property="og:title" content="Loaf & Co. Bakery" />
  <meta property="og:description" content="Roti Asli, Dipanggang Hari Ini." />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet" />

  <style>
    /* ============================================================
       DESIGN TOKENS — Starbucks DNA × Loaf & Co. Artisan Bakery
       Palette adapted: corporate greens → deep herb greens
       Cream canvas, dark forest bands, full-pill CTAs preserved
    ============================================================ */
    :root {
      /* Brand greens */
      --c-brand:       #2d5016;   /* deep herb — headings, brand moments */
      --c-cta:         #4a7c24;   /* herb green — primary CTA fill */
      --c-cta-hover:   #3a6019;   /* pressed CTA */
      --c-band:        #1e2d14;   /* dark forest — feature bands + footer */

      /* Canvas */
      --c-canvas:      #f5f0e6;   /* warm wheat cream — primary page canvas */
      --c-ceramic:     #ece7da;   /* slightly darker cream — dividers */
      --c-white:       #ffffff;
      --c-surface:     #f9f7f2;   /* off-white card surface */

      /* Text */
      --c-ink:         rgba(0,0,0,0.87);
      --c-ink-soft:    rgba(0,0,0,0.54);
      --c-on-dark:     rgba(255,255,255,1);
      --c-on-dark-soft: rgba(255,255,255,0.68);

      /* Accent */
      --c-amber:       #c47a28;   /* wheat amber — badges */
      --c-amber-light: #f5e9d4;

      /* Shadows — whisper-soft layered (Starbucks pattern) */
      --shadow-card: 0 0 0.5px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.18);
      --shadow-nav:  0 1px 3px rgba(0,0,0,0.10), 0 2px 2px rgba(0,0,0,0.06), 0 0 2px rgba(0,0,0,0.07);
      --shadow-frap: 0 0 6px rgba(0,0,0,0.24), 0 8px 12px rgba(0,0,0,0.14);

      /* Spacing (rem-anchored at 16px, matching Starbucks scale intent) */
      --s-1: 4px;  --s-2: 8px;   --s-3: 16px; --s-4: 24px;
      --s-5: 32px; --s-6: 40px;  --s-7: 48px; --s-8: 56px; --s-9: 64px;

      /* Radius — 12px cards, 50px buttons (Starbucks signature) */
      --r-card:   12px;
      --r-pill:   50px;

      /* Typography */
      --f-body:    'Nunito Sans', -apple-system, sans-serif;
      --f-display: 'Playfair Display', 'Iowan Old Style', Georgia, serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--f-body);
      background: var(--c-canvas);
      color: var(--c-ink);
      letter-spacing: -0.01em;
      line-height: 1.5;
      overflow-x: hidden;
    }
    img { display: block; max-width: 100%; }
    a { text-decoration: none; color: inherit; }

    /* ============================================================
       LAYOUT
    ============================================================ */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--s-3);
    }
    @media (min-width: 768px)  { .container { padding: 0 var(--s-4); } }
    @media (min-width: 1024px) { .container { padding: 0 var(--s-6); } }

    .section          { padding: clamp(56px, 8vw, 96px) 0; }
    .section--canvas  { background: var(--c-canvas); }
    .section--white   { background: var(--c-white); }
    .section--band    { background: var(--c-band); color: var(--c-on-dark); }
    .section--ceramic { background: var(--c-ceramic); }

    /* ============================================================
       SCROLL REVEAL
    ============================================================ */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.25,0.1,0.25,1);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    .stagger > * {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.25,0.1,0.25,1);
    }
    .stagger.visible > *:nth-child(1) { opacity:1; transform:translateY(0); transition-delay:0.00s; }
    .stagger.visible > *:nth-child(2) { opacity:1; transform:translateY(0); transition-delay:0.08s; }
    .stagger.visible > *:nth-child(3) { opacity:1; transform:translateY(0); transition-delay:0.16s; }
    .stagger.visible > *:nth-child(4) { opacity:1; transform:translateY(0); transition-delay:0.24s; }
    .stagger.visible > *:nth-child(5) { opacity:1; transform:translateY(0); transition-delay:0.32s; }
    .stagger.visible > *:nth-child(6) { opacity:1; transform:translateY(0); transition-delay:0.40s; }
    .stagger.visible > *:nth-child(7) { opacity:1; transform:translateY(0); transition-delay:0.48s; }
    .stagger.visible > *:nth-child(8) { opacity:1; transform:translateY(0); transition-delay:0.56s; }

    /* ============================================================
       BUTTONS — 50px full-pill, scale(0.95) active (Starbucks DNA)
    ============================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--s-2);
      border-radius: var(--r-pill);
      padding: 10px 22px;
      font-family: var(--f-body);
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.01em;
      border: 1.5px solid transparent;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .btn:active { transform: scale(0.95); }

    .btn-primary  { background: var(--c-cta);  color: #fff; border-color: var(--c-cta); }
    .btn-primary:hover { background: var(--c-cta-hover); border-color: var(--c-cta-hover); }

    .btn-outline  { background: transparent; color: var(--c-cta); border-color: var(--c-cta); }
    .btn-outline:hover { background: rgba(74,124,36,0.08); }

    .btn-on-dark  { background: #fff; color: var(--c-cta); border-color: #fff; }
    .btn-on-dark:hover { background: rgba(255,255,255,0.90); }

    .btn-outline-dark { background: transparent; color: #fff; border-color: rgba(255,255,255,0.65); }
    .btn-outline-dark:hover { background: rgba(255,255,255,0.10); }

    /* ============================================================
       TYPOGRAPHY HELPERS
    ============================================================ */
    .eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--c-cta);
      margin-bottom: var(--s-3);
    }
    .eyebrow--dark { color: var(--c-amber-light); }

    .h2 {
      font-size: clamp(28px, 4vw, 42px);
      font-weight: 600;
      color: var(--c-brand);
      line-height: 1.18;
      letter-spacing: -0.025em;
    }
    .h2--serif  { font-family: var(--f-display); }
    .h2--ondark { color: var(--c-on-dark); }

    .section-sub {
      margin-top: var(--s-3);
      font-size: 16px;
      line-height: 1.65;
      color: var(--c-ink-soft);
    }

    /* ============================================================
       1. NAVBAR
    ============================================================ */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      height: 68px;
      background: var(--c-canvas);
      box-shadow: var(--shadow-nav);
      display: flex;
      align-items: center;
    }
    .nav__inner {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 var(--s-3);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    @media (min-width: 1024px) { .nav__inner { padding: 0 var(--s-6); } }

    .nav__logo {
      font-family: var(--f-display);
      font-size: 22px;
      font-weight: 600;
      color: var(--c-brand);
      letter-spacing: -0.02em;
    }
    .nav__logo em { font-style: italic; color: var(--c-cta); }

    .nav__links {
      display: none;
      list-style: none;
      align-items: center;
      gap: var(--s-6);
    }
    @media (min-width: 768px) { .nav__links { display: flex; } }
    .nav__links a { font-size: 15px; font-weight: 600; color: var(--c-ink); transition: color 0.2s; }
    .nav__links a:hover { color: var(--c-cta); }

    .nav__right { display: flex; align-items: center; gap: var(--s-3); }

    .nav__burger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    @media (min-width: 768px) { .nav__burger { display: none; } }
    .nav__burger span {
      display: block;
      width: 22px; height: 2px;
      background: var(--c-ink);
      border-radius: 2px;
      transition: all 0.25s;
    }
    .nav__burger.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
    .nav__burger.open span:nth-child(2) { opacity: 0; }
    .nav__burger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

    /* Mobile drawer */
    .nav__drawer {
      position: fixed;
      top: 68px; left: 0; right: 0;
      background: var(--c-canvas);
      box-shadow: 0 6px 16px rgba(0,0,0,0.10);
      z-index: 99;
      padding: var(--s-4) var(--s-3);
      display: none;
      flex-direction: column;
      gap: var(--s-1);
    }
    .nav__drawer.open { display: flex; }
    @media (min-width: 768px) { .nav__drawer { display: none !important; } }
    .nav__drawer a {
      font-size: 17px;
      font-weight: 600;
      color: var(--c-ink);
      padding: 12px 0;
      border-bottom: 1px solid var(--c-ceramic);
    }

    /* ============================================================
       2. HERO — cream canvas, 60/40 split, word-reveal headline
    ============================================================ */
    .hero {
      background: var(--c-canvas);
      padding-top: 68px;
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
    .hero__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-8);
      padding: var(--s-8) 0;
      align-items: center;
    }
    @media (min-width: 768px) {
      .hero__grid {
        grid-template-columns: 60% 1fr;
        gap: var(--s-6);
      }
    }

    .hero__content { order: 2; }
    .hero__visual  { order: 1; }
    @media (min-width: 768px) {
      .hero__content { order: 1; }
      .hero__visual  { order: 2; }
    }

    .hero__badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--c-amber-light);
      color: var(--c-amber);
      border: 1px solid rgba(196,122,40,0.22);
      border-radius: var(--r-pill);
      padding: 5px 14px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: var(--s-4);
    }

    .hero__headline {
      font-family: var(--f-display);
      font-size: clamp(36px, 5.5vw, 68px);
      font-weight: 600;
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: var(--c-brand);
      margin-bottom: var(--s-4);
    }

    /* Word-by-word reveal animation */
    .hero__headline .w {
      display: inline-block;
      opacity: 0;
      transform: translateY(18px);
      filter: blur(5px);
      animation: wReveal 0.6s cubic-bezier(0.25,0.1,0.25,1) forwards;
    }
    @keyframes wReveal {
      to { opacity: 1; transform: translateY(0); filter: blur(0); }
    }

    .hero__sub {
      font-size: clamp(15px, 1.7vw, 17px);
      line-height: 1.7;
      color: var(--c-ink-soft);
      max-width: 460px;
      margin-bottom: var(--s-5);
    }

    .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); }

    /* Photo + steam */
    .hero__visual { position: relative; }

    .hero__img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      border-radius: 24px;
      box-shadow: 0 24px 64px rgba(45,80,22,0.22);
    }

    .hero__steam {
      position: absolute;
      top: -22px;
      left: 50%;
      transform: translateX(-50%);
      width: 72px;
      opacity: 0.5;
    }
    .hero__steam path {
      stroke: var(--c-cta);
      fill: none;
      stroke-width: 2.5;
      stroke-linecap: round;
      animation: steam 2.6s ease-in-out infinite;
    }
    .hero__steam path:nth-child(2) { animation-delay: 0.45s; }
    .hero__steam path:nth-child(3) { animation-delay: 0.9s; }
    @keyframes steam {
      0%,100% { opacity: 0; transform: translateY(0) scaleX(1); }
      30%      { opacity: 1; }
      80%      { opacity: 0; transform: translateY(-16px) scaleX(1.2); }
    }

    .hero__caption {
      position: absolute;
      bottom: 18px;
      left: 18px;
      right: 18px;
      background: rgba(30,45,20,0.76);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 10px;
      padding: 12px 16px;
    }
    .hero__caption strong {
      display: block;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 2px;
    }
    .hero__caption span { font-size: 12px; color: var(--c-on-dark-soft); }

    /* ============================================================
       3. STORY — white section, editorial 2-col, serif headline
    ============================================================ */
    .story__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-9);
      align-items: center;
    }
    @media (min-width: 768px) { .story__grid { grid-template-columns: 1fr 1fr; } }

    .story__img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      border-radius: var(--r-card);
      box-shadow: var(--shadow-card);
    }

    .story__quote {
      font-family: var(--f-display);
      font-style: italic;
      font-size: clamp(17px, 2.2vw, 21px);
      color: var(--c-brand);
      border-left: 3px solid var(--c-cta);
      padding-left: var(--s-4);
      line-height: 1.5;
      margin: var(--s-5) 0;
    }

    .story__body { font-size: 15px; line-height: 1.8; color: var(--c-ink); }

    .story__stats {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-5);
      margin-top: var(--s-5);
    }
    .story__stat dt {
      font-size: 30px;
      font-weight: 700;
      color: var(--c-brand);
      letter-spacing: -0.04em;
      line-height: 1;
    }
    .story__stat dd {
      font-size: 12px;
      color: var(--c-ink-soft);
      margin-top: 4px;
      line-height: 1.4;
    }

    /* ============================================================
       4. BREAD MENU — canvas, tab filter, card grid
    ============================================================ */
    .menu__header { text-align: center; margin-bottom: var(--s-7); }
    .menu__header .section-sub { max-width: 520px; margin: var(--s-3) auto 0; text-align: center; }

    .menu__tabs {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--s-2);
      margin-bottom: var(--s-6);
    }
    .menu__tab {
      padding: 8px 20px;
      border-radius: var(--r-pill);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: -0.01em;
      background: var(--c-white);
      color: var(--c-ink-soft);
      border: 1.5px solid var(--c-ceramic);
      cursor: pointer;
      transition: all 0.2s;
    }
    .menu__tab:hover  { border-color: var(--c-cta); color: var(--c-cta); }
    .menu__tab.active { background: var(--c-cta); color: #fff; border-color: var(--c-cta); }

    .menu__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: var(--s-4);
    }

    .menu__card {
      background: var(--c-white);
      border-radius: var(--r-card);
      box-shadow: var(--shadow-card);
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .menu__card:hover {
      transform: translateY(-6px) rotate(-0.4deg);
      box-shadow: 0 14px 36px rgba(45,80,22,0.14);
    }
    .menu__card:hover .menu__card-img { transform: scale(1.06); }
    .menu__card.hidden { display: none; }

    .menu__card-imgwrap { aspect-ratio: 1/1; overflow: hidden; }
    .menu__card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }

    .menu__card-body { padding: 15px; }
    .menu__card-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--c-cta);
      margin-bottom: 5px;
    }
    .menu__card-name  { font-size: 16px; font-weight: 700; color: var(--c-ink); margin-bottom: 5px; }
    .menu__card-desc  { font-size: 13px; line-height: 1.5; color: var(--c-ink-soft); margin-bottom: 11px; }
    .menu__card-price { font-size: 15px; font-weight: 700; color: var(--c-brand); }

    /* ============================================================
       5. PASTRY — white, horizontal scroll snap
    ============================================================ */
    .pastry__header { text-align: center; margin-bottom: var(--s-6); }
    .pastry__header .section-sub { max-width: 480px; margin: var(--s-3) auto 0; text-align: center; }

    .pastry__scroll {
      display: flex;
      gap: var(--s-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--s-2);
      scrollbar-width: thin;
      scrollbar-color: var(--c-ceramic) transparent;
    }
    .pastry__scroll::-webkit-scrollbar { height: 4px; }
    .pastry__scroll::-webkit-scrollbar-thumb { background: var(--c-ceramic); border-radius: 4px; }

    .pastry__card {
      flex: 0 0 240px;
      scroll-snap-align: start;
      background: var(--c-white);
      border-radius: var(--r-card);
      box-shadow: var(--shadow-card);
      overflow: hidden;
      transition: transform 0.3s ease;
    }
    .pastry__card:hover { transform: rotate(-1deg) scale(1.02); }

    .pastry__card-imgwrap { aspect-ratio: 1/1; overflow: hidden; }
    .pastry__card-img { width: 100%; height: 100%; object-fit: cover; }
    .pastry__card-body { padding: 13px 15px; }
    .pastry__card-name  { font-size: 15px; font-weight: 700; color: var(--c-ink); margin-bottom: 3px; }
    .pastry__card-price { font-size: 13px; font-weight: 600; color: var(--c-cta); }

    /* ============================================================
       6. DAILY SCHEDULE — canvas, vertical timeline + photo
    ============================================================ */
    .schedule__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-9);
      align-items: start;
    }
    @media (min-width: 768px) { .schedule__grid { grid-template-columns: 1fr 1fr; } }

    .timeline { position: relative; padding-left: 40px; }
    .timeline::before {
      content: '';
      position: absolute;
      left: 10px; top: 8px; bottom: 8px;
      width: 2px;
      background: rgba(74,124,36,0.22);
      border-radius: 2px;
    }

    .tl-item {
      position: relative;
      padding-bottom: var(--s-5);
      opacity: 0;
      transform: translateX(-14px);
      transition: opacity 0.45s ease, transform 0.45s ease;
    }
    .tl-item:last-child { padding-bottom: 0; }
    .timeline.visible .tl-item:nth-child(1) { opacity:1; transform:translateX(0); transition-delay:0.00s; }
    .timeline.visible .tl-item:nth-child(2) { opacity:1; transform:translateX(0); transition-delay:0.12s; }
    .timeline.visible .tl-item:nth-child(3) { opacity:1; transform:translateX(0); transition-delay:0.24s; }
    .timeline.visible .tl-item:nth-child(4) { opacity:1; transform:translateX(0); transition-delay:0.36s; }
    .timeline.visible .tl-item:nth-child(5) { opacity:1; transform:translateX(0); transition-delay:0.48s; }

    .tl-dot {
      position: absolute;
      left: -34px; top: 4px;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--c-cta);
      border: 3px solid var(--c-canvas);
      box-shadow: 0 0 0 2px var(--c-cta);
      transition: box-shadow 0.3s;
    }
    .tl-item.now .tl-dot {
      background: var(--c-brand);
      box-shadow: 0 0 0 2px var(--c-brand);
      animation: tlPulse 1.8s ease-in-out infinite;
    }
    @keyframes tlPulse {
      0%,100% { box-shadow: 0 0 0 2px var(--c-brand); }
      50%      { box-shadow: 0 0 0 2px var(--c-brand), 0 0 12px rgba(74,124,36,0.5); }
    }

    .tl-time  { font-size: 12px; font-weight: 700; letter-spacing: 0.05em; color: var(--c-cta); margin-bottom: 3px; }
    .tl-title { font-size: 16px; font-weight: 700; color: var(--c-brand); margin-bottom: 2px; }
    .tl-desc  { font-size: 13px; line-height: 1.5; color: var(--c-ink-soft); }

    .schedule__img {
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      border-radius: var(--r-card);
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
    }

    /* ============================================================
       7. PRE-ORDER BAND — dark forest, serif headline
    ============================================================ */
    .preorder__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-6);
      align-items: center;
    }
    @media (min-width: 768px) { .preorder__inner { grid-template-columns: 1fr auto; } }

    .preorder__heading {
